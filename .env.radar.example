# Copy to .env (gitignored) on the machine that holds the sanitized Radar dump.
# Never commit real URLs or passwords.

# Local sanitized copy only — localhost / 127.0.0.1
RADAR_COPY_DATABASE_URL=postgresql://dbro_ro:CHANGEME@127.0.0.1:5432/radar_copy

# Optional: base URL of the Radar app pointed at the copy (local uvicorn)
RADAR_COPY_BASE_URL=http://127.0.0.1:8000

# Optional: read-only prod stats URL — SELECT on pg_stat_statements only
# RADAR_PROD_STATS_URL=postgresql://stats_ro:CHANGEME@PROD_HOST:5432/radar
